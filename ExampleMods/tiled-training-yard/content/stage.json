{
  "schemaVersion": 1,
  "type": "stage",
  "id": "example.tiled-training-yard:stage/tiled-training-yard",
  "displayName": "Tiled Training Yard",
  "extends": "core:stage/field-day",
  "description": "An early authored-layout example loaded from Tiled JSON.",
  "layout": {
    "type": "tiledJson",
    "path": "levels/training-yard.json",
    "pixelsPerUnit": 32
  },
  "waves": {
    "firstWaveEnemyCount": 4
  },
  "spawners": [
    {
      "id": "west-ground",
      "position": { "x": 0, "y": 0 },
      "enemies": ["core:enemy/zombie-1", "core:enemy/zombie-2"],
      "selectionWeight": 1,
      "minimumWave": 0,
      "delaySeconds": 1.5,
      "delayJitterSeconds": 0.25,
      "initialDelaySeconds": 1,
      "initialDelayJitterSeconds": 0.25,
      "spawnOutOfSight": true
    },
    {
      "id": "east-ground",
      "position": { "x": 0, "y": 0 },
      "enemies": ["core:enemy/zombie-1", "core:enemy/death-hound"],
      "selectionWeight": 1,
      "minimumWave": 2,
      "delaySeconds": 1.5,
      "delayJitterSeconds": 0.25,
      "initialDelaySeconds": 1,
      "initialDelayJitterSeconds": 0.25,
      "spawnOutOfSight": true
    }
  ]
}
