{
  "schemaVersion": 1,
  "coordinateSystem": "tiled-top-left-pixels",
  "supportedObjects": [
    { "class": "platform", "shape": "rectangle", "minimum": 1, "properties": { "climbableLeft": "bool", "climbableRight": "bool" } },
    { "class": "player-spawn", "shape": "point", "exactly": 1 },
    { "class": "enemy-spawner", "shape": "point", "minimum": 1, "nameMatches": "stage.spawners[].id" },
    { "class": "decoration", "shape": "tile-object", "minimum": 0, "behavior": "visual-only", "properties": { "repeat": "bool", "sortingLayer": ["Background", "Decoration", "Platform"] } },
    { "class": "weapon-vendor", "shape": "point", "minimum": 0, "behavior": "core-vendor" },
    { "class": "usable-vendor", "shape": "point", "minimum": 0, "behavior": "core-vendor" },
    { "class": "weapon-case", "shape": "point", "minimum": 0, "properties": { "weapon": "item/weapon content ID", "caseSize": "int 1..3" }, "behavior": "core-weapon-case" },
    { "class": "door", "shape": "point", "minimum": 0, "name": "unique switch target ID", "properties": { "doorType": ["standard", "jacky", "roller"], "initiallyOpen": "bool", "price": "int 0..1000000", "singleUse": "bool", "initiallyInteractable": "bool", "requiredItemId": "optional stage-item ID", "openSprite": "optional Core sprite name", "closedSprite": "optional Core sprite name", "proximityRadius": "float >0..100; roller only" }, "behavior": "core-door" },
    { "class": "scripted-actor", "shape": "point", "minimum": 0, "name": "unique stage-script actor ID", "properties": { "enemy": "enemy content ID", "initiallyActive": "bool" }, "behavior": "dormant actor spawned by stage script" },
    { "class": "core-prop", "shape": "point", "minimum": 0, "name": "unique scripted object ID", "properties": { "asset": "stable core:stage-prop/... content ID", "initiallyActive": "bool" }, "behavior": "exact Core presentation hierarchy addressed without a mod-side prefab path" },
    { "class": "door-switch", "shape": "point", "minimum": 0, "properties": { "targetDoors": "comma-separated door object names" }, "behavior": "toggles-linked-doors" },
    { "class": "core-art", "shape": "rectangle", "minimum": 0, "properties": { "art": "ID from reference/core-map-art.json", "sortingLayer": ["Background", "Decoration", "Platform"], "sortingOrder": "int -10000..10000", "flipX": "bool", "flipY": "bool" }, "behavior": "visual-only" },
    { "class": "note", "shape": "point", "minimum": 0, "properties": { "text": "string 1..4096 characters", "fontSize": "int 8..100" }, "behavior": "core-readable-note" },
    { "class": "keypad", "shape": "point", "minimum": 0, "properties": { "code": "1..16 digits", "targetDoors": "comma-separated door object names" }, "behavior": "opens-linked-doors-on-success" },
    { "class": "altar", "shape": "point", "minimum": 0, "behavior": "core-jungle-altar-and-spirit-sequence" },
    { "class": "interaction", "aliases": ["machine", "logic-switch", "easter-egg-step"], "shape": "point/tile object for use; rectangle/tile object for touch/shoot", "minimum": 0, "properties": { "trigger": ["use", "touch", "shoot"], "price": "int 0..1000000; use only", "requiredMoney": "int 0..1000000; checked but not spent", "singleUse": "bool", "message": "string 0..512", "restoreHealth": "float 0..10000", "knockbackX": "float -1000..1000", "knockbackY": "float -1000..1000", "ragdollSeconds": "float 0..60", "minWave": "int >=0", "maxWave": "0 or int >= minWave", "minEnemies": "int 0..10000", "maxEnemies": "0 or int >= minEnemies", "requiredChallenges": "CSV challenge content IDs", "requiredInteractions": "CSV previously completed interaction names", "activationsRequired": "int 1..10000", "delaySeconds": "float 0..3600", "giveMoney": "int -1000000..1000000", "requiredItem": "registered item content ID; use only", "consumeRequiredItem": "bool", "giveItem": "registered item content ID", "giveItemAmount": "int 1..10000 when giveItem is set", "visualArt": "optional ID from core-map-art.json", "visualScale": "float 0.1..20", "targetDoors": "CSV door names", "doorAction": ["open", "close", "toggle"], "targetLights": "CSV light names", "lightAction": ["on", "off", "toggle"], "targetSpawners": "CSV enemy-spawner names", "spawnCount": "int 1..1000 when spawners are set", "targetInteractions": "CSV interaction names" }, "behavior": "validated action/condition node" },
    { "class": "light-bulb", "shape": "point", "minimum": 0, "properties": { "initiallyOn": "bool", "flicker": "float 0..1" }, "behavior": "core light; use toggles and shooting breaks it" },
    { "class": "pickup", "shape": "point", "minimum": 0, "properties": { "item": "registered item content ID", "amount": "int 1..10000; >1 requires stackable item" }, "behavior": "loose world weapon, usable, or consumable" },
    { "class": "moving-platform", "shape": "rectangle", "minimum": 0, "properties": { "moveX": "destination offset in Tiled pixels", "moveY": "destination offset in Tiled pixels", "travelSeconds": "float 0.1..3600", "pauseSeconds": "float 0..3600", "climbableLeft": "bool", "climbableRight": "bool", "art": "ID from core-map-art.json" }, "behavior": "kinematic ping-pong platform with optional grab edges" },
    { "class": "particle-emitter", "shape": "point", "minimum": 0, "properties": { "color": "#RRGGBB or #RRGGBBAA", "rate": "float 0.1..1000", "lifetime": "float 0.05..60", "speed": "float 0..100", "size": "float 0.01..20", "radius": "float 0..100" }, "behavior": "looping visual particles" },
    { "class": "nav-node", "shape": "point", "minimum": 0, "name": "unique link ID", "properties": { "fly": "bool", "connectionType": ["move", "climb"], "links": "CSV nav-node names" }, "behavior": "explicit directed navigation links supplementing generated platform nodes" },
    { "class": "ambient-audio", "shape": "point", "minimum": 0, "properties": { "file": "pack-local .wav or .ogg", "loop": "bool", "volume": "float 0..1" }, "behavior": "non-positional ambience mixer source" },
    { "class": "audio-source", "shape": "point", "minimum": 0, "properties": { "file": "pack-local .wav or .ogg", "loop": "bool", "volume": "float 0..1", "minDistance": "float 0.1..1000", "maxDistance": "float >= minDistance..10000" }, "behavior": "linear-rolloff positional SFX source" },
    { "class": "room", "shape": "rectangle", "minimum": 0, "name": "unique room ID", "properties": { "initial": "bool; at most one room" }, "behavior": "applies its rectangle as the camera bounds while the player is inside" },
    { "class": "room-entry", "shape": "point", "minimum": 0, "name": "unique destination ID", "properties": { "room": "existing room object name" }, "behavior": "named teleport destination inside a room" },
    { "class": "room-transition", "shape": "rectangle", "minimum": 0, "name": "unique transition ID", "properties": { "destination": "existing room-entry object name", "requireNoEnemies": "bool", "oneShot": "bool" }, "behavior": "moves the player to a named room entry; reverse travel requires another transition" }
  ],
  "supportedLayers": ["imagelayer", "tilelayer", "objectgroup", "group"],
  "ignoredByRuntime": ["text", "ellipse", "polygon", "polyline"]
}
