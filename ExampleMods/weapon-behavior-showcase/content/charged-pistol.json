  "extends": "core:item/weapon/pistol",
  "stats": { "damage": 6, "ammoMax": 60, "magazineSize": 10, "value": 25, "marketable": true, "semiAutomatic": true },
  "behavior": {
    "tracerColor": "#FFCC33FF",
    "ammunition": {
