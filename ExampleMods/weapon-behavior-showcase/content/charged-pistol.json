    "animations": { "fireSpeedMultiplier": 1.2, "clips": { "fire": { "frames": [
      { "durationSeconds": 0.06, "sprites": { "slide": "assets/weapon/magazine.png" } },
      { "durationSeconds": 0.08, "sprites": { "slide": "assets/weapon/slide.png" } }
    ] } } }
  },
  "visual": { "type": "coreWeaponSprites", "pixelsPerUnit": 32, "sprites": {
    "body": "assets/weapon/body.png", "base": "assets/weapon/base.png", "slide": "assets/weapon/slide.png"
  } }
