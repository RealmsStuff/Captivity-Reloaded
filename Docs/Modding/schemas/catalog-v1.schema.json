{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Captivity Reloaded community mod catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packs": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "authors", "summary", "sourceRepository", "versions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "not": { "const": "core" } },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
          "authors": { "$ref": "#/definitions/authors" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "sourceRepository": { "type": "string", "pattern": "^https://github\\.com/[^/?#]+/[^/?#]+$" },
          "tags": { "$ref": "#/definitions/tags" },
          "contentWarnings": { "$ref": "#/definitions/warnings" },
		  "previewImages": {
			"type": "array",
			"maxItems": 8,
			"uniqueItems": true,
			"items": { "type": "string", "pattern": "^https://github\\.com/[^/?#]+/[^/?#]+/releases/download/[^/?#]+/[^/?#]+\\.[pP][nN][gG]$" }
		  },
          "versions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "modApiVersion", "gameVersion", "download", "sha256", "sizeBytes"],
              "properties": {
                "version": { "type": "string", "minLength": 5 },
                "modApiVersion": { "type": "integer", "minimum": 1, "maximum": 1000 },
                "gameVersion": { "type": "string", "minLength": 1 },
                "download": { "type": "string", "pattern": "^https://github\\.com/[^/?#]+/[^/?#]+/releases/download/[^/?#]+/[^/?#]+\\.[zZ][iI][pP]$" },
                "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
				"sizeBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
				"dependencies": {
				  "type": "array", "maxItems": 32,
				  "items": { "$ref": "#/definitions/dependency" }
				},
				"conflicts": {
				  "type": "array", "maxItems": 32, "uniqueItems": true,
				  "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
				}
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "authors": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "tags": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
	"warnings": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
	"dependency": {
	  "type": "object", "additionalProperties": false, "required": ["id", "version"],
	  "properties": {
		"id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
		"version": { "type": "string", "minLength": 1, "maxLength": 64 }
	  }
	}
  }
}
