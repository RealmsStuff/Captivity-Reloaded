{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captivity-reloaded.invalid/mod-api/v1/stage-script.schema.json",
  "title": "Captivity Reloaded Stage Script",
  "x-stability": "experimental",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "id", "stage", "sequences"],
  "properties": {
    "schemaVersion": { "const": 1, "x-stability": "experimental" },
    "type": { "const": "stageScript", "x-stability": "experimental" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*:stage-script/[a-z0-9][a-z0-9._/-]*$", "x-stability": "experimental" },
    "stage": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*:stage/[a-z0-9][a-z0-9._/-]*$", "x-stability": "experimental" },
    "variables": { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "type": "number" }, "default": {}, "x-stability": "experimental" },
    "machines": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/machine" }, "default": [], "x-stability": "experimental" },
    "sequences": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/sequence" }, "x-stability": "experimental" }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$" },
    "condition": {
      "type": "object", "additionalProperties": false, "required": ["operator", "value"],
      "properties": {
        "source": { "enum": ["variable", "wave", "enemy-count", "door-open", "object-active"], "default": "variable" },
        "variable": { "$ref": "#/$defs/name" }, "objectId": { "$ref": "#/$defs/name" },
        "enemy": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*:enemy/[a-z0-9][a-z0-9._/-]*$" },
        "operator": { "enum": ["==", "!=", "<", "<=", ">", ">="] }, "value": { "type": "number" }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
		"type": { "enum": ["wait", "wait-for-door", "wait-for-enemy-count", "wait-for-signal", "wait-for-sequence", "wait-until", "wait-until-player-distant", "repeat", "notify", "set-variable", "add-variable", "send-signal", "run-sequence", "start-sequence", "cancel-sequence", "set-machine-state", "set-object-active", "spawn-actor", "move-object", "move-object-to", "rotate-object", "set-door", "set-light", "set-spawner-enabled", "set-interaction-enabled", "activate-interaction", "queue-spawns", "teleport-player", "set-player-input", "set-hud-visible", "set-player-facing", "remove-player-clothing", "play-player-animation", "kill-player", "apply-player-status", "camera-shake", "camera-zoom", "set-global-light", "play-audio", "stop-audio", "play-particles", "play-animation"] },
        "seconds": { "type": "number", "minimum": 0, "maximum": 300 },
        "message": { "type": "string", "minLength": 1, "maxLength": 200 },
        "variable": { "$ref": "#/$defs/name" }, "value": { "type": "number" },
		"signal": { "$ref": "#/$defs/name" }, "objectId": { "$ref": "#/$defs/name" }, "destinationId": { "$ref": "#/$defs/name" }, "active": { "type": "boolean" },
		"state": { "enum": ["open", "closed", "toggle", "on", "off", "at-most", "at-least", "left", "right"] }, "amount": { "type": "integer", "minimum": 1, "maximum": 100 },
		"animation": { "$ref": "#/$defs/name" },
		"controller": { "enum": ["current", "finisher"] },
		"sequence": { "$ref": "#/$defs/name" }
		,"status": { "enum": ["jacky-curse"] }
		,"durationSeconds": { "type": "number", "minimum": 0.1, "maximum": 100000 }
		,"ticksPerSecond": { "type": "number", "minimum": 0.01, "maximum": 60 }
		,"chance": { "type": "number", "minimum": 0, "maximum": 1 }
		,"chanceIncrease": { "type": "number", "minimum": 0, "maximum": 1 }
		,"maxActive": { "type": "integer", "minimum": 1, "maximum": 32 }
		,"x": { "type": "number", "minimum": -100000, "maximum": 100000 }
		,"y": { "type": "number", "minimum": -100000, "maximum": 100000 }
		,"conditions": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/condition" } }
		,"actions": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/action" } }
	  },
	  "allOf": [
		{ "if": { "properties": { "type": { "const": "wait-until" } }, "required": ["type"] }, "then": { "required": ["conditions"] } },
		{ "if": { "properties": { "type": { "const": "repeat" } }, "required": ["type"] }, "then": { "required": ["amount", "actions"] } }
	  ]
    },
    "machineState": {
      "type": "object", "additionalProperties": false, "required": ["id", "actions"],
      "properties": { "id": { "$ref": "#/$defs/name" }, "actions": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/action" } } }
    },
    "machine": {
      "type": "object", "additionalProperties": false, "required": ["id", "objectId", "initialState", "states"],
      "properties": {
        "id": { "$ref": "#/$defs/name" }, "objectId": { "$ref": "#/$defs/name" }, "initialState": { "$ref": "#/$defs/name" },
        "states": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/machineState" } }
      }
    },
    "sequence": {
      "type": "object", "additionalProperties": false, "required": ["id", "trigger", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/name" }, "trigger": { "enum": ["stage-open", "wave-start", "wave-end", "signal", "interaction", "player-enter", "player-exit", "manual", "timer", "door-state", "object-state", "enemy-count", "machine-state"] },
        "signal": { "$ref": "#/$defs/name" }, "once": { "type": "boolean", "default": false },
        "objectId": { "$ref": "#/$defs/name" }, "state": { "enum": ["open", "closed", "active", "inactive", "at-most", "at-least"] },
        "enemy": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*:enemy/[a-z0-9][a-z0-9._/-]*$" },
        "value": { "type": "number" }, "seconds": { "type": "number", "minimum": 0.1, "maximum": 3600 },
        "conditions": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/condition" }, "default": [] },
        "actions": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/action" } }
      }
    }
  }
}
